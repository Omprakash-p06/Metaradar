# ==============================================================================
# MetaRadar Decision Intelligence Platform — Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# FOR PRODUCTION (Netlify + Render + Supabase + Gemini ₹0 Free Tier):
#   Set these variables directly in your host dashboard (Render / Netlify).
#   NEVER commit actual secret keys or credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Production Boot Guard
# ------------------------------------------------------------------------------
# APP_ENV: 'development' | 'production' | 'staging' | 'test'
# When set to 'production', the boot guard enforces:
#   - SECRET_KEY must NOT be default or empty
#   - DEMO_MODE must be false
#   - CORS_ORIGINS must NOT contain wildcard '*'
APP_ENV=development

# Application secret key for HMAC session signing and CSRF tokens.
# IN PRODUCTION: Generate a cryptographically secure 256-bit random key:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-secret-change-in-production

# Enables stakeholder demo persona switching at /auth/demo-login.
# Must be False in production.
DEMO_MODE=true

# ------------------------------------------------------------------------------
# 2. Split-Origin Auth & CORS
# ------------------------------------------------------------------------------
# CORS allowed origins (comma-separated).
# LOCAL: http://localhost:3000
# PRODUCTION: https://<your-app>.netlify.app (exact scheme + host, NO wildcard)
CORS_ORIGINS=http://localhost:3000

# Session cookie SameSite attribute: 'lax' | 'strict' | 'none'
# When deploying split-origin (Netlify frontend -> Render backend),
# modern browsers require SameSite=None; Secure.
# Defaults to 'none' in production, 'lax' in development.
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_SECURE=false

# In-memory authentication & mutation rate limits (requests per minute)
AUTH_RATE_LIMIT_PER_MINUTE=5
MUTATION_RATE_LIMIT_PER_MINUTE=60

# Optional API key required for mutating API endpoints when set
METARADAR_API_KEY=

# ------------------------------------------------------------------------------
# 3. Database & Connection Pooler
# ------------------------------------------------------------------------------
# LOCAL (Docker Compose):
DATABASE_URL=postgresql+asyncpg://metaradar:metaradar_pass@localhost:5432/metaradar

# SUPABASE CLOUD (Free Tier PostgreSQL 16 + pgvector):
# Use the IPv4-compatible Session Pooler on port 5432 (required for asyncpg + Alembic migrations):
# DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?ssl=require

# ------------------------------------------------------------------------------
# 4. Redis Cache (Optional Addon)
# ------------------------------------------------------------------------------
# LOCAL: redis://localhost:6379/0
# CLOUD / FREE TIER: Leave empty. MetaRadar core functionality boots and
# operates completely without Redis (in-memory rate limiting and session handling).
REDIS_URL=redis://localhost:6379/0

# UPSTASH REDIS (Optional free-tier managed Redis addon):
# REDIS_URL=rediss://default:<password>@<endpoint>.upstash.io:6379

# ------------------------------------------------------------------------------
# 5. AI Reasoning & Provider Configuration
# ------------------------------------------------------------------------------
# AI_PROVIDER: 'auto' | 'local' | 'gemini' | 'off'
#   - auto:   Attempts local Gemma -> Gemini free tier -> degraded summary
#   - local:  Local Gemma only (requires Ollama / GGUF)
#   - gemini: Cloud Gemini free tier only
#   - off:    BART degraded summary mode only
AI_PROVIDER=auto

# Local LLM & Ollama Configuration
LLM_PROVIDER=local
LOCAL_LLM_MODEL=google/gemma-3-4b-it
LLM_DEVICE=auto
LLM_DTYPE=int4
MAX_CONTEXT_TOKENS=2048
MAX_OUTPUT_TOKENS=512
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# Google Gemini API (Free Tier Option 1 — ₹0 / $0)
# Obtain free API key at: https://aistudio.google.com/
# Key is server-side only; never expose in frontend bundles.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_S=60.0
GEMINI_MAX_RETRIES=3

# Grok / xAI Hosted Fallback (Disabled in free-tier cloud deployment)
ENABLE_GROK_FALLBACK=false
XAI_API_KEY=

# ------------------------------------------------------------------------------
# 6. Sentence Embeddings (pgvector 384-dimensional)
# ------------------------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL_REVISION=e4bb823e5956b6277b069d276b978c48a73507c7
EMBEDDING_DIMENSION=384
EMBEDDING_MAX_SEQ_LENGTH=256

# ------------------------------------------------------------------------------
# 7. Live Data Connectors & Ingestion
# ------------------------------------------------------------------------------
# NewsAPI Developer Key (required for live news ingestion): https://newsapi.org/register
NEWSAPI_KEY=

# NCBI PubMed API Key & Identifiers (optional, enables higher rate limit)
NCBI_API_KEY=
NCBI_TOOL=MetaRadar
NCBI_EMAIL=metaradar@example.com

# OpenFDA API Key (optional for higher rate limits)
OPENFDA_API_KEY=

# Raw Signal Retention (days before archival)
RAW_SIGNAL_RETENTION_DAYS=30

# ------------------------------------------------------------------------------
# 8. Frontend Public Environment
# ------------------------------------------------------------------------------
# Canonical backend API URL read by Next.js client and server components.
# LOCAL:      http://localhost:8000/api/v1
# PRODUCTION: https://<your-backend>.onrender.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ------------------------------------------------------------------------------
# 9. Deployment Runtime Pins
# ------------------------------------------------------------------------------
PYTHON_VERSION=3.13.5
